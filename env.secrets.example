# Example environment variables for Off Season.
#
# Recommended workflow:
# - Copy this file to `.env.local` (Next.js auto-loads it), OR
# - Copy this file to `env.secrets` and load it via your shell.
#
# Do not commit real secrets.

###############################################################################
# Site URL (public)
###############################################################################
# Used to generate canonical URLs, Open Graph URLs, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://off-season.io

###############################################################################
# Firebase (client / public)
###############################################################################
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

###############################################################################
# Firebase Admin (server / private)
###############################################################################
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# For Vercel, store newlines as \n (the server code normalizes it).
FIREBASE_PRIVATE_KEY=

###############################################################################
# Auth (scaffold)
###############################################################################
# Dev-only: allows API routes to accept any bearer token and treat it as userId.
# This is blocked in production by src/firebase/admin.ts.
OFFSEASON_DEV_BYPASS_AUTH=false

###############################################################################
# Stripe (to implement)
###############################################################################
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MEDIA_SEASON1=
STRIPE_PRICE_ID_MEDIA_S1E1=
STRIPE_PRICE_ID_MEDIA_S1E2=
STRIPE_PRICE_ID_MEDIA_S1E3=
STRIPE_PRICE_ID_MEDIA_S1E4=
STRIPE_PRICE_ID_MEDIA_S1E5=
STRIPE_PRICE_ID_MERCH_HOODIE_BLACK=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

###############################################################################
# Mux (to implement)
###############################################################################
# Public (client): Mux Data environment key used by the web player for analytics.
# Safe to expose in the browser (this is not a secret).
NEXT_PUBLIC_MUX_DATA_ENV_KEY=

# Private (server): used to manage Mux assets (optional if you only sign playback).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Private (server): required for signed playback URLs.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
