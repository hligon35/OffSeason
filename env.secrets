# Off Season — local environment secrets
#
# IMPORTANT
# - This file contains sensitive values. Do not commit it.
# - Add `env.secrets` to `.gitignore` if you keep this filename.
# - For Next.js, you can also copy these into `.env.local`.
#
# -------------------------------------------------------------------
# DEV SAFETY SWITCHES (scaffold-only)
# -------------------------------------------------------------------
# When true, API endpoints accept `Authorization: Bearer <userId>` as a bypass.
OFFSEASON_DEV_BYPASS_AUTH=false

# -------------------------------------------------------------------
# SITE / APP
# -------------------------------------------------------------------
# Production should be: https://off-season.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------------------------------
# FIREBASE (CLIENT) — required for Firebase Auth on web
# -------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_ME
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME
# Optional
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Apple Sign-In note:
# Apple Sign-In configuration happens in Firebase Console + Apple Developer.
# Most of it is not driven by runtime env vars.

# -------------------------------------------------------------------
# FIREBASE (SERVER / ADMIN) — required for verifying ID tokens + Firestore writes
# Use ONE of the following approaches:
# A) Application default creds (GOOGLE_APPLICATION_CREDENTIALS)
# B) Explicit service account env vars (client email + private key)
# -------------------------------------------------------------------
FIREBASE_PROJECT_ID=REPLACE_ME
GOOGLE_APPLICATION_CREDENTIALS=

FIREBASE_CLIENT_EMAIL=
# If you use FIREBASE_PRIVATE_KEY, keep the literal \n sequences.
FIREBASE_PRIVATE_KEY=

# -------------------------------------------------------------------
# FIREBASE EMULATORS (optional for local dev)
# -------------------------------------------------------------------
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# -------------------------------------------------------------------
# STRIPE (SERVER)
# -------------------------------------------------------------------
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME

# -------------------------------------------------------------------
# STRIPE CONNECT (SERVER)
# -------------------------------------------------------------------
# If you are using Stripe Connect, your platform still uses STRIPE_SECRET_KEY.
# Set the connected account that should receive the destination transfer here.
# For a single fixed revenue-share recipient, a single destination account is fine.
# If different creators/partners get paid, store destinationAccountId per product in Firestore.
STRIPE_CONNECT_DESTINATION_ACCOUNT_ID=

# Optional: required only if you implement Connect OAuth onboarding.
# (If you manually create/attach connected accounts in Stripe Dashboard, you may not need this.)
STRIPE_CONNECT_CLIENT_ID=

# Optional (client-side Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -------------------------------------------------------------------
# MUX (SERVER) — secure streaming
# -------------------------------------------------------------------
# API access (for asset management, optional for playback signing depending on approach)
MUX_TOKEN_ID=REPLACE_ME
MUX_TOKEN_SECRET=REPLACE_ME

# Signed playback (recommended)
MUX_SIGNING_KEY_ID=REPLACE_ME
# PEM-encoded private key for the signing key.
# Keep \n sequences if you store it as a single-line env var.
MUX_SIGNING_PRIVATE_KEY=REPLACE_ME

# -------------------------------------------------------------------
# OPTIONAL: LOGGING
# -------------------------------------------------------------------
LOG_LEVEL=info
